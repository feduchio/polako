{
  "name": "polish",
  "version": "0.1.0",
  "description": "Autonomous verification-driven coding orchestrator",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "bin": {
    "polish": "dist/cli/index.js",
    "polishd": "dist/daemon/main.js",
    "polish-mcp": "dist/mcp/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm deps:check && pnpm test",
    "cli:link": "node scripts/cli-link.mjs",
    "cli:unlink": "node scripts/cli-unlink.mjs"
  },
  "dependencies": {
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.3.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
