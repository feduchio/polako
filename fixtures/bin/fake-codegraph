#!/usr/bin/env node
import { mkdirSync, writeFileSync, existsSync } from "node:fs";
import { join } from "node:path";

const [, , cmd, ...rest] = process.argv;
const cwd = process.cwd();
const index = join(cwd, ".codegraph");

function out(v) {
  process.stdout.write(JSON.stringify(v) + "\n");
}

const help = {
  init: "Usage: codegraph init [--json]",
  search: "Usage: codegraph search <query> [--json] [--limit <n>]",
  symbol: "Usage: codegraph symbol <name> [--json]",
  callers: "Usage: codegraph callers <name> [--json]",
  callees: "Usage: codegraph callees <name> [--json]",
  impact: "Usage: codegraph impact [--json] [--depth <n>] [--symbol <name>] [--file <path>]",
  "affected-tests": "Usage: codegraph affected-tests [--json] [--file <path>]",
  refresh: "Usage: codegraph refresh [--json] [--file <path>]",
};

if (cmd === "--version" || cmd === "version") {
  process.stdout.write("fake-codegraph 1.1.6\n");
  process.exit(0);
}
if (cmd === "--help") {
  process.stdout.write(`Commands:\n${Object.keys(help).join("\n")}\n`);
  process.exit(0);
}
if (rest.includes("--help") && Object.hasOwn(help, cmd)) {
  process.stdout.write(help[cmd] + "\n");
  process.exit(0);
}
if (cmd === "probe") {
  out({ ok: true, fts5: true });
  process.exit(0);
}
if (cmd === "init") {
  mkdirSync(index, { recursive: true });
  writeFileSync(join(index, "ok"), "1");
  out({ ok: true, path: index });
  process.exit(0);
}
if (cmd === "search") {
  if (rest[0] === "POLISH_CODEGRAPH_CONTRACT_MARKER_7f31") {
    out([{ path: "src/polish-contract-probe.ts", line: 1, text: rest[0] }]);
    process.exit(0);
  }
  out([{ path: "src/math.ts", line: 1, text: "export function add" }]);
  process.exit(0);
}
if (cmd === "symbol") {
  out([{ name: rest[0] || "add", path: "src/math.ts", line: 1, kind: "function" }]);
  process.exit(0);
}
if (cmd === "callers") {
  out([{ name: rest[0], path: "src/app.ts", line: 4, kind: "caller" }]);
  process.exit(0);
}
if (cmd === "callees") {
  out([{ name: "add", path: "src/app.ts", line: 4, kind: "callee" }]);
  process.exit(0);
}
if (cmd === "impact") {
  out({ files: ["src/math.ts", "src/app.ts"], symbols: ["add"] });
  process.exit(0);
}
if (cmd === "affected-tests") {
  out({ tests: ["tests/math.test.ts"] });
  process.exit(0);
}
if (cmd === "refresh") {
  if (!existsSync(index)) {
    process.stderr.write("no index\n");
    process.exit(1);
  }
  out({ ok: true });
  process.exit(0);
}
process.stderr.write("unknown " + cmd + "\n");
process.exit(2);
